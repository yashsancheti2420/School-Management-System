# Copy this file to .env locally. Do not commit .env.
# Use a long random value before publishing.
SECRET_KEY=replace-with-a-long-random-secret

# Set this to production on a hosting platform. SECRET_KEY then becomes required.
APP_ENV=production

# Optional: point SQLite to a persistent disk supplied by the host.
# DATABASE_PATH=/var/data/schoolmanagement.db

# Optional for local debugging only.
FLASK_DEBUG=false
